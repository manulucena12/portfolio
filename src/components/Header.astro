---
import { Image } from 'astro:assets';
import pfp from '../assets/pfp.jpeg';
// Header MPA: links normales <a href>, sin router. Rápido y sin JS de navegación.
// minimal=true: solo marca + acciones (tema/idioma), sin nav. Para páginas de detalle.
const { current = 'home', minimal = false } = Astro.props;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-profile">
      <div class="avatar-wrapper">
        <Image src={pfp} alt="Manuel Lucena Profile Picture" class="avatar-img" width={44} height={44} widths={[88]} formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
      </div>
      <div class="brand-text">
        <span class="brand-name">Manuel Lucena</span>
      </div>
    </a>

    {!minimal && (
    <nav class="main-nav">
      <ul class="nav-list">
        <li><a href="/#home" class:list={['nav-link', { active: current === 'home' }]} data-nav="home"><span class="nav-num">01</span> <span data-i18n="nav.home">inicio</span></a></li>
        <li><a href="/#about" class:list={['nav-link', { active: current === 'about' }]} data-nav="about"><span class="nav-num">02</span> <span data-i18n="nav.about">sobre mí</span></a></li>
        <li><a href="/#projects" class:list={['nav-link', { active: current === 'proyectos' }]} data-nav="projects"><span class="nav-num">03</span> <span data-i18n="nav.projects">proyectos</span></a></li>
        <li><a href="/#contact" class:list={['nav-link', { active: current === 'contact' }]} data-nav="contact"><span class="nav-num">04</span> <span data-i18n="nav.contact">contacto</span></a></li>
      </ul>
    </nav>
    )}

    <div class="header-actions">
      <button id="lang-toggle-btn" class="icon-btn lang-btn" title="Cambiar idioma / Change language">
        <span class="lang-code" id="current-lang-code">ES</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </button>
      <button id="open-theme-btn" class="icon-btn theme-btn" title="Seleccionar tema / Select theme" aria-label="Abrir selector de temas" aria-expanded="false" aria-controls="theme-drawer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
          <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
          <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
          <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
          <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.92 0 1.7-.75 1.7-1.7 0-.42-.16-.82-.44-1.12-.27-.3-.41-.7-.41-1.13 0-.92.75-1.67 1.67-1.67H16c3.3 0 6-2.7 6-6 0-4.63-4.48-8.4-10-8.4z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

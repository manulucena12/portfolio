---
import 'reveal.js/reveal.css';

// SlidesLayout: documento STANDALONE para presentaciones reveal.js.
// NO usa BaseLayout a propósito: global.css chocaría con reveal.css,
// y el sistema de 7 temas del portfolio no aplica dentro de los slides.
// reveal.js se importa SOLO aquí → Astro lo empaqueta únicamente
// en las rutas que usen este layout. El resto del sitio sigue en 0 JS.
const {
  title = 'Presentación',
  description = 'Presentación con reveal.js',
  pathname = '/',
  backHref = '/presentaciones/',
  backLabel = 'Volver',
} = Astro.props;

const site = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const canonical = site ? `${site}${pathname}` : pathname;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#ffffff" />
  <style>
    /* Tema mínimo propio (claro). No usamos los theme/*.css de reveal
       porque embeben ~560KB de fuentes en base64. */
    /* Newsreader ya está self-hosteada en /fonts para el sitio:
       reutilizarla aquí cuesta 0 bytes nuevos. */
    @font-face {
      font-family: "Newsreader";
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url("/fonts/newsreader-latin-700-normal.woff2") format("woff2");
    }
    @font-face {
      font-family: "Newsreader";
      font-style: italic;
      font-weight: 400;
      font-display: swap;
      src: url("/fonts/newsreader-latin-400-italic.woff2") format("woff2");
    }
    @font-face {
      font-family: "Inter";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("/fonts/inter-latin-400-normal.woff2") format("woff2");
    }
    @font-face {
      font-family: "Inter";
      font-style: normal;
      font-weight: 600;
      font-display: swap;
      src: url("/fonts/inter-latin-600-normal.woff2") format("woff2");
    }
    .reveal {
      font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 46px;
      background: #ffffff;
      color: #111827;
    }
    .reveal h1, .reveal h2, .reveal h3 {
      font-family: "Newsreader", Georgia, serif;
      color: #0c4a6e;
      text-transform: none;
      letter-spacing: -0.01em;
    }
    .reveal .kicker {
      font-family: "Newsreader", Georgia, serif;
      font-style: italic;
      color: #4b5563;
    }
    .reveal a { color: #0284c7; }
    .reveal small { color: #4b5563; }
    /* Matemática KaTeX (renderizada en build, sin JS de cliente) */
    .reveal .katex { font-size: 1.04em; color: #111827; }
    .reveal .katex-display { margin: 0.6em 0; }
    .slides-back {
      position: fixed;
      top: 0.75rem;
      left: 0.75rem;
      z-index: 50;
      font-family: system-ui, -apple-system, sans-serif;
      font-size: 0.8rem;
      font-weight: 600;
      color: #888;
      text-decoration: none;
      background: transparent;
      border: none;
      padding: 0.25rem 0.5rem;
      opacity: 0.7;
    }
    .slides-back:hover { color: #000; opacity: 1; }
  </style>
</head>
<body>
  <a class="slides-back" href={backHref}>&larr; {backLabel}</a>
  <div class="reveal">
    <div class="slides">
      <slot />
    </div>
  </div>
  <script>
    import Reveal from 'reveal.js';
    const deck = new Reveal({
      hash: true,
      controls: false,
      slideNumber: false,
      progress: true,
      center: true,
      transition: 'slide',
    });
    deck.initialize();
  </script>
</body>
</html>
